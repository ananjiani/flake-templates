{
    "mcpServers": {
        "nixos": {
            "command": "uvx",
            "args": ["mcp-nixos"]
        },
        "context7": {
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp"]
        },
        "serena": {
            "command": "uvx",
            "args": ["--from", "git+https://github.com/oraios/serena", "--project", "$(pwd)", "serena-mcp-server"]
        }
    }
}
